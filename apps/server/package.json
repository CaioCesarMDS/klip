{
  "name": "@klip/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build --compile --target bun --outfile klip src/index.ts",
    "start": "./klip",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "rm -rf node_modules dist klip*"
  },
  "dependencies": {
    "@elysia/openapi": "^1.4.15",
    "elysia": "^1.4.28",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "bun-types": "^1.3.13",
    "pino-pretty": "^13.1.3"
  }
}
