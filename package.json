{
  "name": "klip",
  "version": "1.0.0",
  "private": true,
  "description": "A local clipboard manager.",
  "author": "Caio Cesar",
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build --compile --target bun --outfile klip src/index.ts",
    "start": "./klip",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "rm -rf node_modules dist klip"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.5",
    "@elysiajs/openapi": "^1.4.11",
    "@elysiajs/static": "1.4.7",
    "@tanstack/react-query": "^5.90.10",
    "clsx": "^2.1.1",
    "elysia": "^1.4.16",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "bun-types": "^1.3.13"
  }
}
